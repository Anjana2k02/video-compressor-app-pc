<Window
    x:Class="VideoOptimizer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VideoOptimizer">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1120" Padding="32,24" Spacing="20" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="VideoOptimizer" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="{Binding Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Import video" Click="OnImport" IsEnabled="{Binding CanPick}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Import a video" />
                </Grid>

                <InfoBar IsOpen="{Binding HasError, Mode=OneWay}" Severity="Error" Title="Unable to complete that action" Message="{Binding Error}" Closed="OnErrorClosed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Cancel analysis" IsEnabled="{Binding IsBusy}" Click="OnCancel" />
                </Grid>

                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Drop a video anywhere in this window" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="MP4, MOV, MKV, or WebM · Local processing · Your original stays untouched" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ComboBox x:Name="RecentBox" Header="Recent selections · this session" PlaceholderText="Choose a recent video" ItemsSource="{Binding RecentSelections}" DisplayMemberPath="FileName" SelectionChanged="OnRecentSelection" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding FileName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Metadata}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Background="#101217" CornerRadius="12" MinHeight="200">
                    <MediaPlayerElement x:Name="Preview" Height="360" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" AutomationProperties.Name="Video preview">
                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls IsCompact="False" IsSeekBarVisible="True" IsSeekEnabled="True" IsPlaybackRateButtonVisible="False" IsZoomButtonVisible="False" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>
                </Border>
                <InfoBar x:Name="PreviewError" IsOpen="False" Severity="Warning" Title="Preview unavailable" Message="Windows could not play this codec. You can still inspect metadata and select a trim range. Try an H.264/AAC MP4 for preview." />
                <TextBlock Text="{Binding ColorNotice}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <UserControl IsEnabled="{Binding HasVideo}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Choose your trim" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Enter seconds or hh:mm:ss.fff, then apply. You can also mark the current preview position." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="StartField" Header="Start time" Text="{Binding TrimStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTrimKeyDown" AutomationProperties.Name="Trim start time in seconds or hours minutes seconds" />
                            <TextBox Grid.Column="1" x:Name="EndField" Header="End time" Text="{Binding TrimEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTrimKeyDown" AutomationProperties.Name="Trim end time in seconds or hours minutes seconds" />
                        </Grid>
                        <TextBlock Text="{Binding TrimError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4">
                            <Button Content="Apply trim" Click="OnApplyTrim" Margin="0,0,8,8" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Mark start" Click="OnMarkStart" Margin="0,0,8,8" />
                            <Button Content="Mark end" Click="OnMarkEnd" Margin="0,0,8,8" />
                            <Button Content="Reset trim" Click="OnResetTrim" Margin="0,0,8,8" />
                        </VariableSizedWrapGrid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedDuration}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="1" Content="Play selection" Click="OnPlaySelection" />
                        </Grid>
                    </StackPanel>
                    </UserControl>
                </Border>
                <InfoBar IsOpen="{Binding HasPresetWarnings, Mode=OneWay}" Severity="Warning" Title="Some presets were skipped" Message="{Binding PresetWarningMessage}" IsClosable="False" />
                <Border x:Name="ExportCard" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Prepare for upload" FontSize="20" FontWeight="SemiBold" />
                        <ComboBox Header="Destination" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding PresetNote}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ComboBox Header="Quality" ItemsSource="{Binding QualityOptions}" SelectedIndex="{Binding SelectedQualityIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Framing" ItemsSource="{Binding FramingOptions}" SelectedIndex="{Binding SelectedFramingIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Performance" ItemsSource="{Binding PerformanceOptions}" SelectedIndex="{Binding SelectedPerformanceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Find the smallest visually-lossless size (measured VMAF)" IsChecked="{Binding MeasureEnabled, Mode=TwoWay}" IsEnabled="{Binding MeasureAvailable}" />
                        <TextBlock Text="{Binding MeasureNote}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ComboBox Header="Crop position (horizontal)" ItemsSource="{Binding CropHorizontalOptions}" SelectedIndex="{Binding CropHorizontalIndex, Mode=TwoWay}" IsEnabled="{Binding SupportsCropAnchor}" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Crop position (vertical)" ItemsSource="{Binding CropVerticalOptions}" SelectedIndex="{Binding CropVerticalIndex, Mode=TwoWay}" IsEnabled="{Binding SupportsCropAnchor}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding StrategyText}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Size is an estimate; the final file depends on your video's content. Visually lossless does not mean identical to the original." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Export video" Click="OnStartExport" IsEnabled="{Binding CanExport}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ExportBlockedReason}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <InfoBar IsOpen="{Binding HasExportError, Mode=OneWay}" Severity="Error" Title="Export failed" Message="{Binding ExportError}" Closed="OnExportErrorClosed" />
                    </StackPanel>
                </Border>
                <Border x:Name="ProgressCard" Visibility="Collapsed" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Exporting your video" FontSize="18" FontWeight="SemiBold" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ExportFraction}" />
                        <TextBlock Text="{Binding ExportStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Cancel export" Click="OnCancelExport" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border x:Name="CompletionCard" Visibility="Collapsed" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding ResultHeadline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ResultStrategy}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ResultVmaf}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ResultNotices}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Play output" Click="OnPlayOutput" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Open folder" Click="OnOpenFolder" />
                            <Button Content="Export again" Click="OnExportAgain" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Local-first · everything runs offline on your device. Video processing by bundled FFmpeg (GPLv3) — see NOTICE.md and tools/ffmpeg/LICENSE." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
